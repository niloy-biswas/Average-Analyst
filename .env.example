# ─── Supabase ────────────────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
# Server-only: required for admin settings APIs, encrypted secrets, and chat runtime DB overrides
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Encrypt AI keys + BigQuery JSON at rest in Postgres (min 16 chars). Required to save via Admin UI.
SETTINGS_ENCRYPTION_KEY=generate_a_long_random_secret_here

# First boot: promote this profile to admin (optional)
ADMIN_EMAIL=admin@yourdomain.com

# Fallback before app_settings row exists (optional)
ALLOWED_EMAIL_DOMAIN=@yourdomain.com

# ─── LLM Provider ────────────────────────────────────────────────────────────
# Set MODEL_PROVIDER to "anthropic", "openai", or "openrouter" — this is the only
# switch needed to change the active provider. The matching API key and default
# model will be used.

MODEL_PROVIDER=anthropic

ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_DEFAULT_MODEL=claude-sonnet-4-5

OPENAI_API_KEY=sk-...
OPENAI_DEFAULT_MODEL=gpt-5.2

# OpenRouter proxies many vendors behind one OpenAI-compatible API (https://openrouter.ai/keys).
# Model ids are "vendor/model", e.g. anthropic/claude-sonnet-4.
OPENROUTER_API_KEY=sk-or-...
OPENROUTER_DEFAULT_MODEL=openrouter/auto

# ─── BigQuery fallback (used when a dashboard has no DB data_source_id) ───────
BIGQUERY_PROJECT=your-gcp-project-id
BIGQUERY_LOCATION=US

# Service account key JSON — minified to a single line (no newlines)
# Generate from GCP Console > IAM & Admin > Service Accounts > Keys > Add Key > JSON
# Required roles: BigQuery Data Viewer + BigQuery Job User
# Locally you can omit this and use Application Default Credentials (gcloud auth application-default login)
GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account","project_id":"..."}

# ─── Opik Tracing (optional) ─────────────────────────────────────────────────
# Sign up at https://www.comet.com/opik to get an API key
OPIK_API_KEY=your_opik_api_key
OPIK_PROJECT_NAME=evid
OPIK_WORKSPACE=your-workspace-name
OPIK_URL_OVERRIDE=https://www.comet.com/opik/api